# Copy this file to `.env` for local devcontainer, notebook, and tool runs.
# Keep credentials and machine-specific overrides only in `.env`.

# uv environment settings
UV_PROJECT_ENVIRONMENT=.venv
UV_LINK_MODE=copy

# PostgreSQL connection for bootstrap and local PostgreSQL tools
PGHOST=postgres.local
PGPORT=5432
PGDATABASE=ampere_db
PGUSER=postgres
PGPASSWORD=

# MinIO connection for bootstrap and local Iceberg tools
MINIO_S3_ENDPOINT=https://s3.minio.local
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Optional bootstrap TLS verification override. Leave blank for the SDK default.
MINIO_SSL_VERIFY=

# Local source bootstrap. Supply SOURCE_INIT_MODE=reset on the command line.
SCHEMA_INIT=ampere_source
# Staging bucket for the selected bootstrap target.
MINIO_STAGING_BUCKET=ampere-raw
MINIO_STAGING_PREFIX=ampere/source-batches/v1
# Optional seed policy overrides. The bootstrap loads defaults from YAML.
# PROJECT_START_DATE=
# N_OF_INIT_CLIENTS=
# N_DELIVERY_RESOURCE=

# Lakekeeper and Iceberg access for local DuckDB tools and notebooks
LAKEKEEPER_CATALOG_URI=https://lakekeeper.local/catalog
LAKEKEEPER_OAUTH_URI=https://login.microsoftonline.com/2ffd8fbf-1421-46ed-9e6b-021c955dbe34/oauth2/v2.0/token
LAKEKEEPER_SCOPE=api://4120baf5-d479-464e-8c83-a96b5d475fdf/.default
LAKEKEEPER_CLIENT_ID=
LAKEKEEPER_CLIENT_SECRET=
ICEBERG_BRONZE_WAREHOUSE=bronze
ICEBERG_SILVER_WAREHOUSE=silver
ICEBERG_GOLD_WAREHOUSE=gold
DUCKDB_CA_CERT_FILE=

# Spark Connect for local tools and notebooks
AMPERE_SPARK_REMOTE=sc://sparkconnect.local:443/;use_ssl=true
AMPERE_GRPC_SSL_ROOTS_FILE_PATH=

# Optional Raw vs Bronze boundary overrides; blank values use the current Bronze checkpoint.
AMPERE_CHECK_DATASET_ID=
AMPERE_CHECK_END_BATCH_SEQUENCE=
